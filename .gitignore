# Terraform local working data and state must never be committed.
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan

# Lab 8 uses a short-lived SSH key and Terraform-generated inventory.
infra/ansible/.lab8_key
infra/ansible/.lab8_key.pub
infra/ansible/inventory.ini
infra/ansible/known_hosts
infra/ansible/.lab8_instance_id
infra/terraform/tfplan.txt
infra/terraform/tfplan-summary.txt
/infra/terraform/tfplan
infra/terraform/.lab8-backend-ready

